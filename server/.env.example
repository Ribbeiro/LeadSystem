# Porta HTTP da API
PORT=3000

# MongoDB local (docker compose up -d) ou Atlas (mongodb+srv://...)
MONGODB_URI=mongodb://127.0.0.1:27017/leadsystem

# Obrigatório em produção: texto aleatório com 32+ caracteres
JWT_SECRET=troque-por-uma-chave-segura-com-32-caracteres
JWT_EXPIRES_IN=7d

# URL pública usada nos links das fotos enviadas (ex.: https://api.santigrill.com.br)
PUBLIC_URL=

# Contas de demonstração (leandro@email.com / carlos@email.com). Use false em produção.
SEED_DEMO_USERS=true

# E-mail (código de recuperação de senha e avisos de pedido).
# Sem SMTP_HOST, os e-mails são apenas exibidos no console do servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SantiGrill <nao-responda@santigrill.com.br>

# Correios (cotação real de frete). Exige contrato com os Correios.
# Sem estes dados, a API devolve uma estimativa por região (source = "estimativa").
CORREIOS_USER=
CORREIOS_ACCESS_CODE=
CORREIOS_POST_CARD=
CORREIOS_ORIGIN_CEP=09195510
# 03220 = SEDEX, 03298 = PAC (códigos de contrato)
CORREIOS_SERVICES=03220,03298

# Pacote padrão quando o produto não tem peso cadastrado
DEFAULT_PACKAGE_WEIGHT_G=3000
DEFAULT_PACKAGE_LENGTH_CM=50
DEFAULT_PACKAGE_WIDTH_CM=40
DEFAULT_PACKAGE_HEIGHT_CM=30
